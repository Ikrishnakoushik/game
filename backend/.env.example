PORT=3000

# JWT — use a long random string in production (openssl rand -hex 64)
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) during development — no real money charged
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Razorpay webhook secret — set in Razorpay dashboard under Webhooks
# Webhook URL: https://yourdomain.com/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# CORS — comma-separated list of allowed origins, or * for development
# Example: https://app.karmacoins.in,https://www.karmacoins.in
ALLOWED_ORIGINS=*
